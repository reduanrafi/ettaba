[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://gitlab.com/Reduanrafi/ettabashop-website.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "new-system"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/new-system
[branch "feature/commission-distribution-update"]
	vscode-merge-base = origin/new-system
	remote = origin
	merge = refs/heads/feature/commission-distribution-update
